    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const ev = item.json.body || item.json;\n  if (ev.action !== 'opened') continue;\n  if (!ev.issue || ev.issue.pull_request) continue;\n  const repo = ev.repository || {};\n  const full = repo.full_name || '';\n  const issue = ev.issue;\n  const author = (issue.user && issue.user.login) ? issue.user.login : '';\n  const lines = [];\n  if (issue.body) {\n    const text = String(issue.body);\n    const parts = text.split(String.fromCharCode(10));\n    for (let i = 0; i < parts.length && i < 40; i++) lines.push(parts[i]);\n  }\n  out.push({ json: {\n    owner: repo.owner ? repo.owner.login : '',\n    repo: repo.name || '',\n    repoFullName: full,\n    number: issue.number,\n    title: String(issue.title || ''),\n    body: lines.join(String.fromCharCode(10)),\n    author: author,\n    issueUrl: issue.html_url || '',\n    issueKey: full + '#' + issue.number,\n  }});\n}\nreturn out;"
      },
      "id": "de5de9a4-509d-4ff3-b16f-fe72bd9265a2",
      "name": "Parse Issue (opened only)",
