    {
      "parameters": {
        "jsCode": "const allowed = ['bug', 'task', 'feature'];\nconst ctx = $('Parse Issue (opened only)').first().json;\nconst out = [];\n\nconst comments = {\n  bug: 'Спасибо за обращение! Похоже, это баг — пометили Issue меткой **bug** и добавили в очередь исправлений.',\n  task: 'Спасибо! Issue отнесли к задачам — метка **task**. Возьмём в работу по плану.',\n  feature: 'Спасибо за идею! Отнесли Issue к улучшениям — метка **feature**. Обсудим на планировании.',\n};\n\nfor (const item of $input.all()) {\n  const type = String(item.json.type || '').toLowerCase();\n  const confidence = Number(item.json.confidence || 0);\n  const known = allowed.includes(type);\n  const confident = confidence >= 0.8;\n  const effective = (known && confident) ? type : 'unknown';\n  out.push({ json: {\n    owner: ctx.owner,\n    repo: ctx.repo,\n    number: ctx.number,\n    issueKey: ctx.issueKey,\n    title: ctx.title,\n    author: ctx.author,\n    type: known ? type : 'unknown',\n    confidence: confidence,\n    label: effective === 'unknown' ? 'needs-triage' : effective,\n    comment: comments[effective] || '',\n    reason: effective === 'unknown'\n      ? (known ? 'confidence ' + confidence + ' < 0.8' : 'тип не определён')\n      : 'type=' + effective + ', confidence=' + confidence,\n  }});\n}\nreturn out;"
      },
