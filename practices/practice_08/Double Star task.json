    {
      "parameters": {
        "jsCode": "const ALLOWED_PREFIX = 'practices/practice_07.2/sandbox/';\nconst out = [];\nfor (const item of $input.all()) {\n  const ev = item.json.body || item.json;\n  if (!ev.issue) continue;\n  const labels = (ev.issue.labels || []).map(function (l) { return typeof l === 'string' ? l : l.name; });\n  const isBug = labels.indexOf('bug') !== -1;\n  const relevant = (ev.action === 'labeled' && ev.label && ev.label.name === 'bug') ||\n                   (ev.action === 'opened' && isBug);\n  if (!relevant) continue;\n\n  const repo = ev.repository || {};\n  const full = repo.full_name || '';\n  const body = String(ev.issue.body || '');\n  const match = body.match(/([A-Za-z0-9_./-]+\\.py)/);\n  let filePath = match ? match[1] : '';\n  if (!filePath) filePath = ALLOWED_PREFIX + 'pricecalc.py';\n  if (filePath.indexOf(ALLOWED_PREFIX) !== 0) continue;\n\n  const number = ev.issue.number;\n  out.push({ json: {\n    owner: repo.owner ? repo.owner.login : '',\n    repo: repo.name || '',\n    number: number,\n    title: String(ev.issue.title || ''),\n    body: body,\n    filePath: filePath,\n    branch: 'ai-fix/issue-' + number,\n    issueUrl: ev.issue.html_url || '',\n  }});\n}\nreturn out;"
      },
