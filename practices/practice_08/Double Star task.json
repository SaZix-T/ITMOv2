    {
      "parameters": {
        "jsCode": "const ctx = $('Decode File + Build Prompt').first().json;\nlet text = String($input.first().json.text || '').trim();\nconst fence = String.fromCharCode(96, 96, 96);\nif (text.indexOf(fence) === 0) {\n  text = text.split(fence).join('').replace(/^python/i, '').trim();\n}\nif (!text) {\n  return [];\n}\nconst changed = text !== ctx.original.trim();\nreturn [{ json: {\n  owner: ctx.owner,\n  repo: ctx.repo,\n  number: ctx.number,\n  title: ctx.title,\n  filePath: ctx.filePath,\n  branch: ctx.branch,\n  issueUrl: ctx.issueUrl,\n  sha: ctx.sha,\n  fixed: text,\n  contentBase64: Buffer.from(text, 'utf8').toString('base64'),\n  changed: changed,\n  message: 'fix: ' + ctx.title + ' (closes #' + ctx.number + ')',\n}}];"
      },
