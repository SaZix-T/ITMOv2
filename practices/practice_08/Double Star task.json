    {
      "parameters": {
        "jsCode": "const ctx = $('Parse Bug Report').first().json;\nconst res = $input.first().json;\nconst code = Buffer.from(String(res.content || '').replace(/\\n/g, ''), 'base64').toString('utf8');\nconst prompt = [\n  'Ты старший разработчик. В репозитории есть баг-репорт и исходный файл с ошибкой.',\n  'Исправь ошибку минимальным изменением, не меняя публичный API и стиль файла.',\n  '',\n  '=== БАГ-РЕПОРТ ===',\n  ctx.title,\n  '',\n  ctx.body,\n  '',\n  '=== ФАЙЛ ' + ctx.filePath + ' ===',\n  code,\n  '',\n  'Верни ТОЛЬКО полный исправленный код файла: без пояснений, без markdown-обёртки и без троеточий.',\n  'Код должен быть синтаксически корректным Python.',\n].join(String.fromCharCode(10));\nreturn [{ json: {\n  owner: ctx.owner,\n  repo: ctx.repo,\n  number: ctx.number,\n  title: ctx.title,\n  filePath: ctx.filePath,\n  branch: ctx.branch,\n  issueUrl: ctx.issueUrl,\n  sha: res.sha,\n  original: code,\n  prompt: prompt,\n}}];"
      },
