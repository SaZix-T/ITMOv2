    {
      "parameters": {
        "jsCode": "const ctx = $('Prepare Commit').first().json;\nconst pr = $('Open Pull Request').first().json;\nconst diff = String($input.first().json.data || '');\nconst prompt = [\n  'Ты ревьюер кода. Ниже diff автоматического исправления бага.',\n  'Оцени, можно ли это мержить в main без доработки.',\n  '',\n  'Блокирующими считаются: неверная логика, потерянная функциональность, синтаксические ошибки,',\n  'сломанные импорты, необработанные исключения в основном сценарии, отладочные print.',\n  'Косметика (стиль, форматирование) — НЕ блокирует.',\n  '',\n  '=== ISSUE ===',\n  ctx.title,\n  '',\n  '=== DIFF ===',\n  diff,\n  '',\n  'Ответ в формате:',\n  'первая строка — ВЕРДИКТ: OK или ВЕРДИКТ: BLOCK',\n  'дальше — 1-3 строки пояснения по-русски.',\n].join(String.fromCharCode(10));\nreturn [{ json: {\n  owner: ctx.owner,\n  repo: ctx.repo,\n  number: ctx.number,\n  title: ctx.title,\n  branch: ctx.branch,\n  prNumber: pr.number,\n  prUrl: pr.html_url || '',\n  prompt: prompt,\n}}];"
      },
