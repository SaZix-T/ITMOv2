    {
      "parameters": {
        "jsCode": "const ctx = $('Build Review Prompt').first().json;\nconst text = String($input.first().json.text || '');\nconst block = /ВЕРДИКТ:\\s*BLOCK/i.test(text);\nconst ok = /ВЕРДИКТ:\\s*OK/i.test(text);\nlet blocking = true;\nif (ok && !block) blocking = false;\nif (!ok && !block) blocking = true;\nreturn [{ json: {\n  owner: ctx.owner,\n  repo: ctx.repo,\n  number: ctx.number,\n  prNumber: ctx.prNumber,\n  prUrl: ctx.prUrl,\n  title: ctx.title,\n  blocking: blocking,\n  verdict: text.trim(),\n}}];"
      },
