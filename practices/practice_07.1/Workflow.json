      "id": "2c658f33-c5b5-45dc-8bb6-06b10687f11f",
      "name": "DeepSeek Model (primary)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1632,
        688
