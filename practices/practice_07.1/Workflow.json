    {
      "parameters": {
        "jsCode": "const hunks = $('Split Diff Into Hunks').all().map(function (i) { return i.json; });\nif (!hunks.length) return [];\n\nconst byId = {};\nfor (const h of hunks) byId[String(h.hunkId)] = h;\n\nconst parsed = [];\nfor (const item of $input.all()) {\n  const raw = String(item.json.text || item.json.output || '').trim();\n  let hunkId = null;\n  let comment = '';\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start !== -1 && end > start) {\n    try {\n      const obj = JSON.parse(raw.slice(start, end + 1));\n      if (obj && obj.hunk !== undefined && obj.hunk !== null) hunkId = String(obj.hunk).replace(/[^0-9]/g, '');\n      if (obj && typeof obj.comment === 'string') comment = obj.comment;\n    } catch (e) {}\n  }\n  if (!comment) {\n    const fence = String.fromCharCode(96, 96, 96);\n    comment = raw.split(fence).join('').replace(/^[a-zA-Z]*\\n/, '').trim();\n  }\n  if (!hunkId) {\n    const mm = raw.match(/Block ID:[ ]*([0-9]+)/);\n    if (mm) hunkId = mm[1];\n  }\n  parsed.push({ hunkId: hunkId, comment: comment });\n}\n\nconst used = {};\nconst picked = [];\nconst leftovers = [];\nconst make = function (h, text) {\n  const body = String(text || '').trim();\n  return { path: h.path, line: h.line, side: 'RIGHT', body: body ? body.slice(0, 4000) : 'Замечаний нет' };\n};\n\nfor (const p of parsed) {\n  const h = p.hunkId ? byId[p.hunkId] : null;\n  if (h && !used[p.hunkId]) {\n    used[p.hunkId] = true;\n    picked.push(make(h, p.comment));\n  } else {\n    leftovers.push(p);\n  }\n}\n\nlet li = 0;\nfor (const h of hunks) {\n  const key = String(h.hunkId);\n  if (used[key]) continue;\n  if (li >= leftovers.length) break;\n  used[key] = true;\n  picked.push(make(h, leftovers[li].comment));\n  li++;\n}\n\nconst files = {};\nfor (const c of picked) files[c.path] = true;\nconst fileCount = Object.keys(files).length;\nconst first = hunks[0];\nconst model = first.model || '';\n\nreturn [{ json: {\n  owner: first.owner,\n  repo: first.repo,\n  prNumber: first.prNumber,\n  prKey: first.prKey,\n  command: first.command,\n  model: model,\n  mode: first.mode,\n  reviewKind: first.reviewKind,\n  comments: picked,\n  commentsCount: picked.length,\n  reviewedAt: new Date().toISOString(),\n  reviewBody: [\n    '## AI code review',\n    '',\n    '- Модель: ' + model,\n    '- Команда: ' + first.command,\n    '- Блоков изменённого кода: ' + picked.length,\n    '- Файлов: ' + fileCount,\n    '',\n    'Замечания опубликованы точечно — отдельным комментарием к каждому блоку diff.',\n  ].join(String.fromCharCode(10))\n}}];"
      },
