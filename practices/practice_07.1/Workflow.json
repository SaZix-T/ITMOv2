    {
      "parameters": {
        "jsCode": "const out = [];\nconst MAX_HUNKS = 25;\nconst MAX_HUNK_CHARS = 6000;\n\nfor (const item of $input.all()) {\n  let ctx = null;\n  try {\n    const a = $('Prepare PR (opened only)').first().json;\n    if (a && a.prNumber) ctx = a;\n  } catch (e) {}\n  if (!ctx) {\n    try {\n      const b = $('Prepare Command').first().json;\n      if (b && b.prNumber) ctx = b;\n    } catch (e) {}\n  }\n  if (!ctx) continue;\n\n  const j = item.json || {};\n  const diff = typeof j.data === 'string' ? j.data : (typeof j.body === 'string' ? j.body : '');\n  if (!diff) continue;\n\n  const lines = diff.split('\\n');\n  const hunks = [];\n  let path = null;\n  let current = null;\n  const flush = function () {\n    if (path && current) hunks.push(current);\n    current = null;\n  };\n\n  for (let i = 0; i < lines.length; i++) {\n    const raw = lines[i];\n    if (raw.indexOf('diff --git ') === 0) { flush(); path = null; continue; }\n    if (!current && raw.indexOf('+++ ') === 0) {\n      const p = raw.slice(4).trim();\n      path = p === '/dev/null' ? null : p.replace(/^b\\//, '');\n      continue;\n    }\n    if (!current && raw.indexOf('--- ') === 0) continue;\n    const hm = /^@@ -[0-9]+(?:,[0-9]+)? \\+([0-9]+)(?:,[0-9]+)? @@/.exec(raw);\n    if (hm) {\n      flush();\n      current = { path: path, start: parseInt(hm[1], 10), header: raw, body: [] };\n      continue;\n    }\n    if (!current) continue;\n    if (raw.indexOf('Binary files') === 0) { current = null; continue; }\n    if (raw.indexOf('\\\\') === 0) continue;\n    current.body.push(raw);\n  }\n  flush();\n\n  for (const h of hunks) {\n    if (out.length >= MAX_HUNKS) break;\n    let cursor = h.start;\n    let anchor = null;\n    let fallback = null;\n    for (const ln of h.body) {\n      const tag = ln.charAt(0);\n      if (tag === '+') {\n        if (anchor === null) anchor = cursor;\n        cursor++;\n      } else if (tag === ' ') {\n        if (fallback === null) fallback = cursor;\n        cursor++;\n      } else if (tag === '-') {\n        continue;\n      } else {\n        cursor++;\n      }\n    }\n    if (anchor === null) anchor = fallback;\n    if (anchor === null) continue;\n\n    let text = h.header + '\\n' + h.body.join('\\n');\n    if (text.length > MAX_HUNK_CHARS) text = text.slice(0, MAX_HUNK_CHARS) + '\\n... (блок обрезан)';\n\n    const hunkId = out.length + 1;\n    const prompt = [\n      'Ты senior-разработчик и делаешь code review одного блока изменённого кода из pull request.',\n      '',\n      'Файл: ' + h.path,\n      'Заголовок блока: ' + h.header,\n      'Block ID: ' + hunkId,\n      ctx.prTitle ? ('PR: ' + ctx.prTitle) : '',\n      '',\n      'Изменённый код (unified diff, один блок):',\n      '~~~diff',\n      text,\n      '~~~',\n      '',\n      'Найди: баги, проблемы безопасности, регрессии, проблемы производительности, нарушения best practices.',\n      'Пиши по-русски, конкретно, не более 600 символов, можно markdown.',\n      'Если замечаний нет — напиши: Замечаний нет.',\n      '',\n      'Ответ верни СТРОГО как JSON без markdown-обёртки:',\n      '{\"hunk\": ' + hunkId + ', \"comment\": \"<текст ревью>\"}',\n    ].join('\\n');\n\n    out.push({ json: {\n      owner: ctx.owner,\n      repo: ctx.repo,\n      prNumber: ctx.prNumber,\n      prKey: ctx.prKey,\n      command: ctx.command,\n      mode: ctx.mode,\n      reviewKind: ctx.reviewKind,\n      model: ctx.model,\n      source: ctx.source,\n      path: h.path,\n      line: anchor,\n      side: 'RIGHT',\n      hunkId: hunkId,\n      hunkHeader: h.header,\n      prompt: prompt,\n    }});\n  }\n}\nreturn out;"
      },
