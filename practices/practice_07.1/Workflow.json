      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const ev = item.json.body || item.json;\n  if (ev.action && ev.action !== 'created') continue;\n  if (!ev.issue || !ev.issue.pull_request) continue;\n  const text = String((ev.comment && ev.comment.body) || '').trim();\n  let command = '';\n  let mode = '';\n  let model = '';\n  if (text.indexOf('/make_other_ai_review') === 0) {\n    command = '/make_other_ai_review';\n    mode = 'secondary';\n    model = 'openai/gpt-5.1';\n  } else if (text.indexOf('/make_ai_review') === 0) {\n    command = '/make_ai_review';\n    mode = 'primary';\n    model = 'deepseek/deepseek-v4.1-flash-1017';\n  } else {\n    continue;\n  }\n  const repo = ev.repository || {};\n  const full = repo.full_name || '';\n  out.push({ json: {\n    owner: repo.owner ? repo.owner.login : '',\n    repo: repo.name || '',\n    repoFullName: full,\n    prNumber: ev.issue.number,\n    prTitle: ev.issue.title || '',\n    command: command,\n    mode: mode,\n    reviewKind: mode === 'secondary' ? 'secondary' : 'primary',\n    model: model,\n    source: 'command',\n    prKey: full + '#' + ev.issue.number,\n  }});\n}\nreturn out;"
      },
